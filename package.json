{
  "name": "campus-desk",
  "version": "1.0.0",
  "private": true,
  "description": "A fictional college department website published as an open agentic website: a manifest, three small agents, a browser runtime and a chat page.",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "seed": "node scripts/seed-data.mjs",
    "network": "tsx scripts/build-network.ts",
    "runtime": "tsx scripts/build-runtime.ts",
    "prepare:site": "npm run network --silent && npm run runtime --silent",
    "dev": "npm run prepare:site --silent && next dev -p 5173",
    "build:site": "npm run prepare:site --silent && next build",
    "build:peer": "tsx scripts/build-peer.ts",
    "start": "next start -p 5173",
    "serve:peer": "node scripts/serve.mjs dist-peer 5174",
    "check:style": "node scripts/check-style.mjs",
    "typecheck": "tsc --noEmit",
    "test": "npm run prepare:site --silent && vitest run",
    "build": "npm run check:style && npm run typecheck && npm run test && next build && npm run build:peer",
    "check": "tsx tools/agentic-check.ts public",
    "check:live": "tsx tools/agentic-check.ts http://localhost:5173/",
    "e2e": "node --import tsx scripts/e2e.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "agent:demo": "tsx tools/visiting-agent.ts",
    "deck": "node scripts/deck.mjs"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.5",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "axe-core": "^4.14.0",
    "esbuild": "^0.28.2",
    "jsdom": "^31.0.1",
    "postcss": "^8.5.33",
    "puppeteer-core": "^25.17.0",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@libsql/client": "^0.18.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "framer-motion": "^14.14.0",
    "lucide-react": "^1.73.0",
    "next": "^16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0"
  }
}
