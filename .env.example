# Copy to .env.local for local work, or set these in your host's dashboard. Nothing here is a real secret.

# Database. Leave empty locally: a SQLite file is made at data/campus.db and seeded on first start.
# For a hosted copy use a free Turso database (libSQL, the same SQL as SQLite):
#   DATABASE_URL=libsql://campus-desk-<you>.turso.io
#   DATABASE_AUTH_TOKEN=<token from `turso db tokens create campus-desk`>
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Ed25519 private key (PKCS8 PEM) that signs grants and receipts. If empty, a key is made and stored in the database.
# Set it on a host where the database can be reset, so old receipts still verify.
#   openssl genpkey -algorithm ed25519
SIGNING_KEY_PEM=

# The sample student (ananya@eastbrook.example) that makes sign-in easy to try. Set to 0 to turn it off.
SEED_DEMO_ACCOUNT=1

# The site clock. Empty: fixed at the sample date (Mon 16 Nov 2026, 10:20) so demo answers never change.
# Set to "real" to use the actual time in Asia/Kolkata.
SITE_CLOCK=

# Where the sample library site (dist-peer) is served. Used when the network files are built, so the
# manifest lists it in allowed_peers, and by the Activity page link.
PEER_LIBRARY_URL=http://localhost:5174/library_desk
NEXT_PUBLIC_PEER_URL=http://localhost:5174

# Used only by `npm run build:peer`: the Campus Desk origin the library study planner calls.
CAMPUS_DESK_URL=http://localhost:5173
